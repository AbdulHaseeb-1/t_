{
  "name": "db-intelligence",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter server start:dev",
    "build": "pnpm --filter server build",
    "start": "pnpm --filter server start:prod",
    "test": "pnpm --filter server test && pnpm --filter mobile test",
    "test:e2e": "pnpm --filter server test:e2e",
    "lint": "pnpm --filter server lint && pnpm --filter mobile lint",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter mobile typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "mobile": "pnpm --filter mobile start",
    "mobile:web": "pnpm --filter mobile web"
  }
}
