# Server settings for the MDS_EPD database (pharmacy distribution ERP).
# Copy into the repo-root .env and fill in the secrets. Measured with
# apps/server/eval/datasets/mds-epd.json: 100% (SQL Server) and 99.2% (Option B)
# on 40 questions x 3 runs.

PORT=3000
NODE_ENV=production
LOG_LEVEL=warn
# REQUIRED as soon as the server is reachable from outside this computer.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=

# ── Option A: live SQL Server ──────────────────────────────────────────
DB_ENGINE=mssql
DB_HOST=localhost          # the SQL Server machine (IP or name); use host\INSTANCE only via DB_PORT
DB_PORT=1433
DB_NAME=MDS_EPD
DB_USER=db_intel_reader    # read-only login, see docs/CONNECT-DATABASE.md step 2
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ── Option B: no SQL Server, read a copy of the .mdf directly ─────────────
# (comment out Option A's DB_ENGINE line above; DB_* settings are then unused)
# DB_ENGINE=duckdb
# MDF_IMPORT_PATH=/path/to/copy/MDS_EPD_SQL16.mdf
# DUCKDB_FILE=data/mds.duckdb
# MDF_IMPORT_EXCLUDE=dbo.AuditTrail*,dbo.BackupHistory,dbo.ErrorLog,dbo.UserSession,dbo.Users,dbo.UserGroup,dbo.Organization,dbo.DocFormatConfig,dbo.ReportTemplate*,dbo.ScreenControlConfig,dbo.InvoiceRuleConfig,dbo.ExportPanel,dbo.Import,dbo.uvTextFile

# App internals, audit and configuration tables: never useful for business questions.
# The uv*/ *View report views repeat invoice totals on every line and mislead SUMs;
# the base tables hold the same data.
SCHEMA_EXCLUDE=dbo.AuditTrail*,dbo.BackupHistory,dbo.ErrorLog,dbo.UserSession,dbo.Users,dbo.UserGroup,dbo.Organization,dbo.DocFormatConfig,dbo.ReportTemplate*,dbo.ScreenControlConfig,dbo.InvoiceRuleConfig,dbo.ExportPanel,dbo.Import,dbo.uvTextFile,dbo.uv*,dbo.*View
SCHEMA_NOTES_FILE=infra/mssql/mds-epd.schema-notes.json

OPENAI_API_KEY=
LLM_PROVIDER=openai
