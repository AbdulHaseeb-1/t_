# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set in any shared/deployed environment: clients must send `x-api-key`.
API_KEY=
CORS_ORIGINS=http://localhost:5173
THROTTLE_LIMIT_PER_MIN=60

# ── SQL Server ────────────────────────────────────────────────────────
# Used only by docker compose / attach script.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MDF_FILE=MDS_EPD_SQL16.mdf
# The API connects as a db_datareader login created by infra/mssql/attach.sh.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MDS_EPD
DB_USER=db_intel_reader
DB_PASSWORD=ChangeMe_Reader1!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10
DB_REQUEST_TIMEOUT_MS=30000
DB_MAX_ROWS=1000
DB_READ_UNCOMMITTED=true

# ── Schema context ────────────────────────────────────────────────────
# Glob filters on schema.table, e.g. SCHEMA_INCLUDE=mdm.viw_*,dbo.*
SCHEMA_INCLUDE=
SCHEMA_EXCLUDE=
SCHEMA_FULL_CONTEXT_MAX_CHARS=24000
SCHEMA_MAX_TABLES=10

# ── Accuracy features (measure with: pnpm --filter server eval --preset ablation)
SCHEMA_VALUE_HINTS=true
# Column-name tokens that are never sampled into the prompt:
SCHEMA_VALUE_HINTS_EXCLUDE=name|mail|phone|mobile|fax|address|street|zip|postal|ssn|passport|password|pwd|token|secret|iban|card|account|birth|dob|salary|note|comment|description|url|ip
EXAMPLES_FILE=examples.json
ASK_FEWSHOT_K=0
ASK_SQL_CANDIDATES=1
ASK_EMPTY_RESULT_RECHECK=true

# ── LLM routing ───────────────────────────────────────────────────────
# auto = try LLM_FALLBACK_ORDER with circuit breakers; or pin: openai | openrouter
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=openai,openrouter
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=1500
# none | minimal | low | medium | high. Measured on gpt-6-luna: none was ~2.5x faster and
# ~2.4x cheaper than the default with equal accuracy. Smart tier = escalation, so it reasons more.
LLM_REASONING_EFFORT_FAST=none
LLM_REASONING_EFFORT_SMART=medium

OPENAI_API_KEY=
# Same model on both tiers; escalation differs only by reasoning effort. Use gpt-6-sol for a stronger (20x pricier) fallback.
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6-luna

OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-5
# price | throughput | latency
OPENROUTER_PROVIDER_SORT=throughput

# ── Caching / agent ───────────────────────────────────────────────────
CACHE_SQL_TTL_S=86400
CACHE_ANSWER_TTL_S=120
ASK_MAX_REPAIRS=2
AGENT_MAX_STEPS=8
