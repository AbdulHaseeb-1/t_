# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set in any shared/deployed environment: clients must send `x-api-key`.
API_KEY=
CORS_ORIGINS=http://localhost:5173
THROTTLE_LIMIT_PER_MIN=60

# ── SQL Server ────────────────────────────────────────────────────────
# Used only by docker compose / attach script.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MDF_FILE=MDS_EPD_SQL16.mdf
# mssql = live SQL Server (below). duckdb = no SQL Server: the built-in MDF reader
# converts MDF_IMPORT_PATH into DUCKDB_FILE (read-only) at startup and on POST /schema/refresh.
DB_ENGINE=mssql
DUCKDB_FILE=data/database.duckdb
MDF_IMPORT_PATH=
# schema.table globs never converted (audit trails, users, settings)
MDF_IMPORT_EXCLUDE=
# The API connects as a db_datareader login created by infra/mssql/attach.sh.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MDS_EPD
DB_USER=db_intel_reader
DB_PASSWORD=ChangeMe_Reader1!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10
DB_REQUEST_TIMEOUT_MS=30000
DB_MAX_ROWS=1000
DB_READ_UNCOMMITTED=true

# ── Schema context ────────────────────────────────────────────────────
# Glob filters on schema.table, e.g. SCHEMA_INCLUDE=mdm.viw_*,dbo.*
SCHEMA_INCLUDE=
SCHEMA_EXCLUDE=
# Curated table/column notes (grain, which amount is "sales"). Example: infra/mssql/mds-epd.schema-notes.json
SCHEMA_NOTES_FILE=
# Columns the model never sees and the API refuses to query (globs on column name).
# Empty = built-in list: *password*, *passwd*, *pwd*, *secret*, *token*, *cnic*, *ssn*
DB_DENY_COLUMNS=
SCHEMA_FULL_CONTEXT_MAX_CHARS=24000
SCHEMA_MAX_TABLES=10

# ── Accuracy features (measure with: pnpm --filter server eval --preset ablation)
SCHEMA_VALUE_HINTS=true
# Column-name tokens that are never sampled into the prompt. Leave unset for the built-in
# list (names, phones, addresses, IDs, GPS, cheques, audit users...); values that look like
# phones, e-mails or coordinates are dropped regardless.
# SCHEMA_VALUE_HINTS_EXCLUDE=
EXAMPLES_FILE=examples.json
ASK_FEWSHOT_K=0
ASK_SQL_CANDIDATES=1
ASK_EMPTY_RESULT_RECHECK=true

# ── LLM routing ───────────────────────────────────────────────────────
# auto = try LLM_FALLBACK_ORDER with circuit breakers; or pin: openai | openrouter
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=openai,openrouter
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=1500
# none | minimal | low | medium | high. Measured on gpt-6-luna: none was ~2.5x faster and
# ~2.4x cheaper than the default with equal accuracy. Smart tier = escalation, so it reasons more.
LLM_REASONING_EFFORT_FAST=none
LLM_REASONING_EFFORT_SMART=medium

OPENAI_API_KEY=
# Same model on both tiers; escalation differs only by reasoning effort. Use gpt-6-sol for a stronger (20x pricier) fallback.
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6-luna

# Voice and photo questions.
# Speech to text: auto = Gemini when GEMINI_API_KEY is set (cheaper, strong on Urdu), else OpenAI;
# the other provider is the automatic fallback. gemini | openai force one provider first.
TRANSCRIBE_PROVIDER=auto
# Key from https://aistudio.google.com/apikey. gemini-3.5-flash-lite: ~$0.001 per minute of audio;
# gemini-3.8-flash: more accurate on noisy audio, ~$0.0065 per minute.
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# OpenAI speech model (used when no Gemini key, or as the fallback).
TRANSCRIBE_MODEL=gpt-4o-transcribe
VISION_REASONING_EFFORT=low
MEDIA_MAX_AUDIO_MB=10
MEDIA_MAX_IMAGE_MB=8
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-5
# price | throughput | latency
OPENROUTER_PROVIDER_SORT=throughput

# ── Caching / agent ───────────────────────────────────────────────────
CACHE_SQL_TTL_S=86400
CACHE_ANSWER_TTL_S=120
ASK_MAX_REPAIRS=2
AGENT_MAX_STEPS=8
