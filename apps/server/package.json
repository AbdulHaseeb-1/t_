{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "eval": "nest build && node --enable-source-maps dist/eval/cli.js"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/throttler": "6.7.0",
    "fastify": "5.12.5",
    "lru-cache": "11.5.3",
    "mssql": "12.7.2",
    "nestjs-pino": "5.2.0",
    "openai": "7.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "1.85.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "source-map-support": "^0.5.21",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
